<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Provides a foundational implementation of a typical design-time code generation application
      that executes multiple Waffle templates.
    </Description>
    <Title>Waffle.Bakery</Title>
    <PackageId>Waffle.Bakery</PackageId>
    <PackageTags>template;code-generation;batch</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Waffle.Core\Waffle.Core.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
